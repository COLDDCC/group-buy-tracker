{
  "manifest_version": 3,
  "name": "代购团购收集助手",
  "version": "0.4.0",
  "description": "在商品页面一键抓取图片/名称/价格，自动写入飞书电子表格，图片用 IMAGE() 公式显示缩略图；团员名字留空，后续手动核对填写。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "代购团购收集助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://open.feishu.cn/*"],
  "background": {
    "service_worker": "background.js"
  }
}
